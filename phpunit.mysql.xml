<?xml version="1.0" encoding="UTF-8"?>
<!--
    TEST-02: run the suite against MariaDB (the production engine) instead of the
    default SQLite :memory:. SQLite silently no-ops lockForUpdate(), relaxes the
    orders/subscriptions ENUMs, and never exercises the MySQL DATE_FORMAT branch of
    Customer::scopeUpcomingBirthday(), so a green SQLite run does not prove the app
    is correct on production.

    Usage (see _artifacts/audit/11_MYSQL_VERIFICATION.md for the container command):
        php artisan test -c phpunit.mysql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- Pinned so tests never depend on a developer.s local APP_TIMEZONE. Kept
             DIFFERENT from config(billing.timezone)=Asia/Kolkata on purpose, so
             UTC-vs-IST day-boundary bugs surface in the suite (TEST-04). -->
        <env name="APP_TIMEZONE" value="UTC" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>

        <!-- Production engine, not SQLite. -->
        <env name="DB_CONNECTION" value="mariadb" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3307" force="true"/>
        <env name="DB_DATABASE" value="osms_test" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="root" force="true"/>
        <env name="DB_URL" value="" force="true"/>

        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
