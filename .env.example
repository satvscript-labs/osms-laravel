APP_NAME=OSMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev + CI use SQLite; production uses MariaDB (see .env.prod).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=osms
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---- Razorpay (test keys locally; live keys only in .env.prod) ----
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC_MONTHLY=
RAZORPAY_PLAN_BASIC_YEARLY=

# ---- SaaS configuration ----
SAAS_REQUIRE_EMAIL_VERIFICATION=false
SAAS_LEGAL_ENTITY="Your Registered Business Name"
SAAS_GST_NUMBER=
SAAS_SUPPORT_EMAIL=support@example.test
SAAS_CONTACT_ADDRESS=
SAAS_MAX_STAFF=5
SAAS_INVITE_DAYS=7

# ---- Security (SEC-04 / SEC-05) ----
# CSP ships Report-Only; flip to true only after verifying no violations in-browser.
CSP_ENABLED=true
CSP_ENFORCE=false
# Enrol a superadmin in 2FA BEFORE setting this true, or you lock yourself out.
SUPERADMIN_REQUIRE_2FA=false

# ---- Error tracking (Sentry) — empty = disabled ----
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=

# ---- Superadmin seed account (osms:make-superadmin --from-env) ----
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="admin@example.test"
SUPERADMIN_PASSWORD=

# ---- Legacy migration (Sahaj Optical cutover only) ----
# The customer's OLD system, read directly instead of shuttling dump files.
# STRICTLY READ-ONLY — use a MySQL user with SELECT only. Leave blank to disable;
# `--from-db` then fails with a clear message instead of connecting to anything.
# See _artifacts/FirstCustomerFiles/LEGACY_DB_ACCESS.md
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
