* text=auto eol=lf

# Shell scripts must keep LF endings or they fail on the Linux server with
# "bad interpreter: /bin/bash^M".
*.sh text eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
